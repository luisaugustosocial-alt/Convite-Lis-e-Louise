rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /eventSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /rsvps/{rsvpId} {
      // Convidados podem confirmar presença sem fazer login.
      allow create: if request.resource.data.keys().hasOnly(['fullName','companions','createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.companions is list
        && request.resource.data.companions.size() <= 10;

      // Apenas contas autenticadas podem consultar as confirmações.
      allow read: if isSignedIn();
      allow update, delete: if false;
    }
  }
}